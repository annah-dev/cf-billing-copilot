/**
 * Every binding the app needs is declared here at Stop 2, so no lane edits this file.
 * Frozen after the foundation PR merges: a change is its own PR to main.
 * Reference: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-billing-copilot",
	"main": "src/server.ts",
	"compatibility_date": "2026-06-11",
	"compatibility_flags": ["nodejs_compat"],

	// Workers AI: Llama 3.3 (model id in src/contracts/config.ts). Always remote, even in dev.
	"ai": {
		"binding": "AI",
		"remote": true
	},

	// Chat UI and /admin are static assets; the Worker runs first only for API and agent routes.
	"assets": {
		"directory": "./public",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/agents/*", "/api/*"]
	},

	// BillingAgent: one per sandbox + customer (the binding name drives the /agents/billing-agent/ route).
	// LEDGER: one per sandbox, the system of record. QUOTA: one global instance for daily counters.
	"durable_objects": {
		"bindings": [
			{ "name": "BillingAgent", "class_name": "BillingAgent" },
			{ "name": "LEDGER", "class_name": "Ledger" },
			{ "name": "QUOTA", "class_name": "Quota" }
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["BillingAgent", "Ledger", "Quota"]
		}
	],

	"workflows": [
		{
			"name": "credit-request-workflow",
			"binding": "CREDIT_WORKFLOW",
			"class_name": "CreditRequestWorkflow"
		}
	],

	// Per-IP brake in front of every Durable Object call (D-13). Per location and approximate by design.
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 60, "period": 60 }
		}
	],

	// Caps and timeouts (D-6, D-7). Parsed and validated by EnvConfigSchema in src/contracts/config.ts.
	"vars": {
		"APPROVAL_TIMEOUT": "24 hours",
		"NEURON_DAILY_STOP": "50000",
		"MAX_OUTPUT_TOKENS": "512",
		"SANDBOXES_PER_DAY_GLOBAL": "200",
		"SANDBOXES_PER_DAY_PER_IP": "5",
		"MESSAGES_PER_SANDBOX_DAY": "30",
		"MESSAGE_MAX_CHARS": "2000",
		"CREDIT_REQUESTS_PER_SANDBOX_DAY": "5",
		"API_REQUESTS_PER_SANDBOX_DAY": "200",
		"SANDBOX_IDLE_DAYS": "7"
	},

	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
