{
  "name": "cf-billing-copilot",
  "version": "1.0.0",
  "private": true,
  "description": "AI billing copilot on Cloudflare: Agents SDK, Workers AI (Llama 3.3), Durable Objects and Workflows",
  "keywords": [
    "agents",
    "ai",
    "cloudflare",
    "billing"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "oxfmt --check . && oxlint src/ && tsc",
    "deploy": "vite build && wrangler deploy",
    "dev": "vite dev",
    "eval:live": "vitest run --config evals/vitest.live.config.ts",
    "format": "oxfmt --write .",
    "lint": "oxlint src/",
    "start": "vite dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/agent",
    "types": "wrangler types env.d.ts"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "^0.9.3",
    "@cloudflare/kumo": "^2.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/code": "^1.1.1",
    "agents": "^0.17.4",
    "ai": "^6.0.197",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "streamdown": "^2.5.0",
    "workers-ai-provider": "^3.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@cloudflare/vite-plugin": "^1.46.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.144.0"
  },
  "allowScripts": {
    "core-js-pure@3.49.0": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260721.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260926.1": true,
    "workerd@1.20260815.1": true
  }
}
