    {
      "id": "wf-note",
      "type": "text",
      "x": 568,
      "y": 1651.45,
      "width": 753.8004760742188,
      "height": 40.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g12"
      ],
      "frameId": null,
      "index": "b09",
      "roundness": null,
      "seed": 151419442,
      "version": 2,
      "versionNonce": 1371571374,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790839212234,
      "link": null,
      "locked": false,
      "text": "Every step is an idempotent Ledger call that writes its own audit record. The Workflow acts on the\ndecision recorded in the Ledger, never on the event payload. Expiry is a terminal state with its own audit record.",
      "fontSize": 15,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every step is an idempotent Ledger call that writes its own audit record. The Workflow acts on the\ndecision recorded in the Ledger, never on the event payload. Expiry is a terminal state with its own audit record.",
      "autoResize": true,
      "lineHeight": 1.35
    },
