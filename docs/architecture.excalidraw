    {
      "id": "engine-body",
      "type": "text",
      "x": 98,
      "y": 1885.4,
      "width": 1060.3729248046875,
      "height": 68.85000000000001,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g17"
      ],
      "frameId": null,
      "index": "b0D",
      "roundness": null,
      "seed": 483333554,
      "version": 2,
      "versionNonce": 464367918,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790839212234,
      "link": null,
      "locked": false,
      "text": "Rating with graduated tiers, proration by active days, tax once per invoice, invoice build and compare, plan simulation, anomaly detection\n(one-day spikes against a leave-one-out median) and credit claim validation. Integer cents with exact fraction math, rounded once per line.\nThe same code produces the seeded invoices and every figure the tools return.",
      "fontSize": 17,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rating with graduated tiers, proration by active days, tax once per invoice, invoice build and compare, plan simulation, anomaly detection\n(one-day spikes against a leave-one-out median) and credit claim validation. Integer cents with exact fraction math, rounded once per line.\nThe same code produces the seeded invoices and every figure the tools return.",
      "autoResize": true,
      "lineHeight": 1.35
    },
