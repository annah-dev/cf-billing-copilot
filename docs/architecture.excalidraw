      "link": null,
      "locked": false,
      "text": "One Cloudflare Worker. A chat agent per customer in a Durable Object, the ledger in Durable Object SQLite,\nand credit requests in a Workflow that waits for a human approver. All money math is deterministic TypeScript.",
      "fontSize": 18,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One Cloudflare Worker. A chat agent per customer in a Durable Object, the ledger in Durable Object SQLite,\nand credit requests in a Workflow that waits for a human approver. All money math is deterministic TypeScript.",
