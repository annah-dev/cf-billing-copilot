    {
      "id": "ledger-body",
      "type": "text",
      "x": 1178,
      "y": 968.0999999999999,
      "width": 244.45941162109375,
      "height": 321.30000000000007,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g10"
      ],
      "frameId": null,
      "index": "am",
      "roundness": null,
      "seed": 1466052334,
      "version": 2,
      "versionNonce": 1426874418,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790839212234,
      "link": null,
      "locked": false,
      "text": "The single source of truth:\nplans, usage, invoices, ledger\nentries, credit requests, credit\nmemos, append-only audit log\n\nCredit state machine: one\ntransition, one audit record\nIdempotency key per request\nPer-charge reservation, so one\ncharge is never credited twice\nFirst recorded decision wins\nAlarm: recovery, expiry, cleanup\nDaily caps per sandbox on\nmessages, credits, API calls",
      "fontSize": 17,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The single source of truth:\nplans, usage, invoices, ledger\nentries, credit requests, credit\nmemos, append-only audit log\n\nCredit state machine: one\ntransition, one audit record\nIdempotency key per request\nPer-charge reservation, so one\ncharge is never credited twice\nFirst recorded decision wins\nAlarm: recovery, expiry, cleanup\nDaily caps per sandbox on\nmessages, credits, API calls",
      "autoResize": true,
      "lineHeight": 1.35
    },
