      "boundElements": null,
      "updated": 1790839212234,
      "link": null,
      "locked": false,
      "text": "Llama 3.3 only chooses tools and explains their results. Every amount comes from the billing engine in integer cents, travels as\n{ cents, display } validated by schema, and the grounding guard removes any figure that is not in a tool result from that turn.",
      "fontSize": 18,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Llama 3.3 only chooses tools and explains their results. Every amount comes from the billing engine in integer cents, travels as\n{ cents, display } validated by schema, and the grounding guard removes any figure that is not in a tool result from that turn.",
      "autoResize": true,
      "lineHeight": 1.35
    },
